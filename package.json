{
  "name": "vinyl-value-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Records every vinyl in the collection, keeps each one's market value fresh, and knows what the whole thing is worth.",
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run types && npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply vinyl-value-vault --local",
    "db:migrate:remote": "wrangler d1 migrations apply vinyl-value-vault --remote"
  },
  "dependencies": {
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.5",
    "@msw/cloudflare": "^0.2.0",
    "@types/node": "^26.6.4",
    "msw": "^3.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  }
}
