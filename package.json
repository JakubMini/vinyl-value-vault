{
  "name": "vinyl-value-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Records every vinyl in the collection, keeps each one's market value fresh, and knows what the whole thing is worth.",
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types",
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run types && npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply vinyl-value-vault --local --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply vinyl-value-vault --remote --config wrangler.jsonc",
    "egress:here": "node scripts/egress.ts here",
    "egress:pool": "node scripts/egress.ts pool",
    "egress:status": "node scripts/egress.ts status",
    "egress:remove": "node scripts/egress.ts remove"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@msw/cloudflare": "^0.2.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "msw": "^3.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
