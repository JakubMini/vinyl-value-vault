{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vinyl-value-vault",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Where the vault answers. vault.jakubszypicyn.com is a Custom Domain (added 3 Oct 2026):
  // Cloudflare creates its DNS record and certificate on deploy. The zone is on the same
  // personal account. The Access application protects the Worker itself, not a hostname, so
  // every address it answers on is behind the same login and the same audience tag (ACCESS_AUD
  // below). Wrangler turns workers.dev off once a route exists unless told otherwise; it stays
  // on for scripts and the Alexa skill.
  "routes": [{ "pattern": "vault.jakubszypicyn.com", "custom_domain": true }],
  "workers_dev": true,

  // The dashboard: a single-page app built by Vite into static assets. Asset requests are
  // served without running the Worker (free and unmetered); /api/* always reaches the Worker,
  // and any other unknown path gets index.html so client-side routes survive a reload.
  // The directory is set by @cloudflare/vite-plugin at build time, so plain `wrangler dev`
  // and `wrangler deploy` need `npm run build` first (npm run deploy does it).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Non-secret settings. Secrets (DISCOGS_TOKEN, API_KEY, DISCOGS_ROAD) live in .dev.vars
  // locally and are set with `wrangler secret put` in production. See README.
  "vars": {
    "VALUATION_CURRENCY": "GBP",
    // Records per run on the pool road. Each costs up to two Discogs calls. Discogs allows
    // 60 a minute per client address, and every Worker calling a Cloudflare-hosted site
    // shares one (2a06:98c0:3600::103), so the window is usually spent already: a run
    // every five minutes with a small batch takes what it can without knocking constantly.
    "VALUATION_BATCH_SIZE": "5",
    // Records per run on the tunnel road, where the allowance is the vault's own. The
    // limit is the Workers free plan's 50 subrequests, D1 calls included: 3 per run (two
    // reads and the snapshot), plus up to 3 per record (two Discogs calls and one write), so
    // 15 records is at most 48, and at most 30 Discogs calls a minute: half the allowance.
    "VALUATION_TUNNEL_BATCH_SIZE": "15",
    // A record priced within this many hours is not priced again.
    "VALUATION_REFRESH_HOURS": "24",
    "DISCOGS_USER_AGENT": "VinylValueVault/0.1 +https://github.com/JakubMini/vinyl-value-vault",
    // Cloudflare Access, which lets the dashboard in through a browser login (enabled on
    // 2 Oct 2026; it protects the Worker on every hostname, vault.jakubszypicyn.com included).
    // The team domain issues the tokens and publishes their keys; the audience tag names this
    // Access application. Neither is secret. If either is emptied,
    // Access tokens are refused and only the API key works.
    "ACCESS_TEAM_DOMAIN": "https://nameless-sky-8a5a.cloudflareaccess.com",
    "ACCESS_AUD": "4f34a4445eb3398643394a2aab4782bf53eedb56e462df77a2fb9ef5cd0d5195"
  },

  // Created by the first `wrangler deploy` on 2 Oct 2026 (automatic provisioning).
  // The id is pinned so every command resolves the same database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vinyl-value-vault",
      "database_id": "53c97c0d-5111-4503-bd84-84755daf3c2d",
      "migrations_dir": "migrations"
    }
  ],

  // The tunnel road out to Discogs (see README, "The road to Discogs"). A Workers VPC
  // service, `discogs-api`, for api.discogs.com on port 443, reached through the Cloudflare
  // Tunnel `vinyl-vault-egress`, whose connector runs on a laptop (scripts/egress.ts). Calls
  // through it leave from that laptop's address. Used only when DISCOGS_ROAD is "tunnel".
  "vpc_services": [
    {
      "binding": "DISCOGS_EGRESS",
      "service_id": "01a0fd3e-bf71-7072-a308-0d07914661a8"
    }
  ],

  // The valuation job. The cron ticks every minute. On the tunnel road every tick prices up
  // to VALUATION_TUNNEL_BATCH_SIZE records that are due, longest-waiting first; on the pool
  // road only every fifth tick does, with VALUATION_BATCH_SIZE. Once a day a tick syncs the
  // Discogs collection instead (src/sync.ts), so the two never share one invocation.
  "triggers": {
    "crons": ["* * * * *"]
  }
}
